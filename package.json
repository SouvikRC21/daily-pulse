{
  "name": "daily-pulse",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Apple Watch fitness dashboard with automatic nightly sync from an iPhone Shortcut.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute daily-pulse --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute daily-pulse --local --file=schema.sql",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
